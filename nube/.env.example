# Copia este archivo como .env para cambiar los valores de desarrollo. Sin .env se usan los de abajo.
# Son contraseñas de tu PC, no de Azure: en Azure las contraseñas viven en Key Vault y nunca en archivos.
DB_NOMBRE=captura
DB_ADMIN_USUARIO=captura_admin
DB_ADMIN_CLAVE=admin_local_cambiar
DB_APP_CLAVE=app_local_cambiar
JWT_DEV_SECRETO=clave-local-solo-para-desarrollo-32-bytes-minimo
